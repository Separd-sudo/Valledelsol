# =========================================================
# CONFIGURACIÓN DE PUERTOS LOCALES 
# =========================================================
PORT_BFF=8080
PORT_GATEWAY=8000
PORT_MS_REPORTES=8081
PORT_MS_USUARIOS=8082
PORT_MS_ALERTAS=8084
#PORT_MS_SENSORES=8084
PORT_MS_ANALITICA=8085
PORT_MS_GEOGRAFICO=8086

PORT_DB_REPORTES=5433
PORT_DB_USUARIOS=5434
PORT_DB_ALERTAS=5432
#PORT_DB_SENSORES=5436
PORT_DB_ANALITICA=5437
PORT_DB_GEOGRAFICO=5438

# =========================================================
# CONFIGURACIÓN DE BASES DE DATOS POSTGRESQL
# =========================================================
DB_USER=valle_user
DB_PASS=valle_pass

DB_NAME_REPORTES=reportes_db
DB_NAME_USUARIOS=usuarios_db
DB_NAME_ALERTAS=alertas_db
#DB_NAME_SENSORES=sensores_db
DB_NAME_ANALITICA=analitica_db
DB_NAME_GEOGRAFICO=geografico_db
# =========================================================
# URLS DE INTEGRACIÓN SÍNCRONA (Para Docker Compose)
# =========================================================
# Dentro de la red de Docker, los contenedores se hablan usando sus nombres de servicio
SPRING_DATASOURCE_URL_REPORTES=jdbc:postgresql://postgres-reportes:5432/reportes_db
SPRING_DATASOURCE_URL_USUARIOS=jdbc:postgresql://postgres-usuarios:5432/usuarios_db
SPRING_DATASOURCE_URL_ALERTAS=jdbc:postgresql://postgres-alertas:5432/alertas_db
SPRING_DATASOURCE_URL_ANALITICA=jdbc:postgresql://postgres-analitica:5432/analitica_db
SPRING_DATASOURCE_URL_GEOGRAFICO=jdbc:postgresql://postgres-geografico:5432/geografico_db

# Las rutas del BFF ahora apuntan al puerto 8000 de Kong
MS_USUARIOS_URL=http://ms-usuarios:8082
MS_REPORTES_URL=http://ms-reportes:8081
MS_ANALITICA_URL=http://ms-analitica:8085
MS_GEOGRAFICO_URL=http://ms-geografico:8086
MS_ALERTAS_URL=http://ms-alertas:8084